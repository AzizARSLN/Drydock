# ── Core ────────────────────────────────────────────────────────────────────
# Address the API/UI binds to. Keep it on loopback and put a reverse proxy in
# front of it when exposing Drydock beyond localhost.
DRYDOCK_ADDR=127.0.0.1:8788

# Directory for the SQLite database and generated artifacts.
DRYDOCK_DATA_DIR=./data
DRYDOCK_DB=./data/drydock.db

# Directory that holds the compiled web UI (index.html + assets).
DRYDOCK_WEB_DIR=./web

# ── Secrets (change these!) ─────────────────────────────────────────────────
# DRYDOCK_MASTER_KEY encrypts stored SSH credentials (AES-256-GCM) at rest.
# Must be at least 32 characters. Generate with: openssl rand -hex 32
DRYDOCK_MASTER_KEY=change-me-to-a-random-32-character-secret

# DRYDOCK_JWT_SECRET signs session tokens. Generate with: openssl rand -hex 32
DRYDOCK_JWT_SECRET=change-me-to-another-random-32-character-secret

# Session lifetime in hours.
DRYDOCK_TOKEN_TTL_HOURS=12

# ── Networking ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (needed only when the dev
# frontend runs on a separate origin from the API).
DRYDOCK_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Feature toggles ─────────────────────────────────────────────────────────
DRYDOCK_ENABLE_TERMINAL=true
DRYDOCK_ENABLE_SFTP=true

# Background health sweep interval, in seconds.
DRYDOCK_HEALTH_INTERVAL=60
